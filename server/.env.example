# Server
PORT=8080
NODE_ENV=development
LOG_LEVEL=info

# Persistence — leave MONGODB_URI empty to use the in-memory store
MONGODB_URI=

# Audit behaviour
AUDIT_TIMEOUT_MS=8000
AUDIT_MAX_REDIRECTS=5
AUDIT_MAX_RESPONSE_BYTES=2000000
AUDIT_MAX_CONCURRENCY=20
AUDIT_ACQUIRE_TIMEOUT_MS=4000
AUDIT_ALLOW_PRIVATE_IPS=false

# Cache window
CACHE_TTL_MS=60000
CACHE_MAX_ENTRIES=5000

# Rate limiting (per client)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60
